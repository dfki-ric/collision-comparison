<?xml version="1.0" ?>
<!-- Link pairs that are excluded from the TIAGo self-collision benchmark (in addition to the rules in
     compare-python/src/load_tiago.py). Collected from:
     - reason="Blacklist": collision_model_parameters/blacklist/default in
       config/collision/collision_parameters.yaml of tiago_description in example-robot-data
       (https://github.com/Gepetto/example-robot-data, commit 78b6101a6387de721316b0db717351d899f97b4f), Apache License 2.0
     - reason="Adjacent" and reason="Default" (colliding in the default configuration): the files tiago_no-arm,
       tiago_no-ee, pal-hey5 and tiago_pal-hey5 in config/srdf/disable_collisions/ of tiago_moveit_config
       (https://github.com/pal-robotics/tiago_moveit_config, branch humble-devel, commit a71258d5f22f2bd06ead8db78bba8cef7a58962e), Apache License 2.0
     Pairs with reason="Never" (never colliding in MoveIt's sampling) are not excluded. Pairs of links that are not in
     tiago.urdf (e.g., the PAL gripper) are omitted. -->
<robot name="tiago">
  <disable_collisions link1="arm_2_link" link2="torso_lift_link" reason="Blacklist"/>
  <disable_collisions link1="arm_5_link" link2="wrist_ft_link" reason="Blacklist"/>
  <disable_collisions link1="arm_5_link" link2="wrist_ft_tool_link" reason="Blacklist"/>
