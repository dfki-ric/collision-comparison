diff -ru a/include/hpp/fcl/shape/geometric_shapes.h b/include/hpp/fcl/shape/geometric_shapes.h
--- a/include/hpp/fcl/shape/geometric_shapes.h	2026-11-01 16:18:52.032684743 +0100
+++ b/include/hpp/fcl/shape/geometric_shapes.h	2026-11-01 16:18:52.060684446 +0100
@@ -658,6 +658,14 @@
   /// is guaranteed in the internal of the polytope (as it is convex)
   Vec3f center;
 
+  /// @brief Cached extremes for the hill climbing (as in MuJoCo): the vertex
+  /// with the largest dot product with each direction (cx, cy, cz) in
+  /// {-1, 0, 1}^3, index 9 (cx + 1) + 3 (cy + 1) + (cz + 1). The hill climbing
+  /// starts at the cached extreme of the grid cell of the search direction if
+  /// use_extrema is set (filled by the user).
+  bool use_extrema = false;
+  int extrema[27] = {};
+
  protected:
   /// @brief Construct an uninitialized convex object
   /// Initialization is done with ConvexBase::initialize.
diff -ru a/src/narrowphase/gjk.cpp b/src/narrowphase/gjk.cpp
--- a/src/narrowphase/gjk.cpp	2026-11-01 16:18:52.040684658 +0100
+++ b/src/narrowphase/gjk.cpp	2026-11-01 16:18:52.060684446 +0100
@@ -195,6 +195,17 @@
   const ConvexBase::Neighbors* nn = convex->neighbors;
 
   if (hint < 0 || hint >= (int)convex->num_points) hint = 0;
+  if (convex->use_extrema) {
+    // as in MuJoCo: start at the cached extreme vertex of the grid cell of the
+    // direction (each component of the normalized direction is mapped to -1, 0,
+    // or 1 with the threshold 0.4) if it is better than the hint
+    const FCL_REAL threshold = 0.4 * dir.norm();
+    int cell = 0;
+    for (int k = 0; k < 3; ++k)
+      cell = 3 * cell + (dir[k] > threshold) - (dir[k] < -threshold) + 1;
+    const int extreme = convex->extrema[cell];
+    if (pts[extreme].dot(dir) > pts[hint].dot(dir)) hint = extreme;
+  }
   FCL_REAL maxdot = pts[hint].dot(dir);
   std::vector<int8_t>& visited = data->visited;
   visited.assign(convex->num_points, false);
